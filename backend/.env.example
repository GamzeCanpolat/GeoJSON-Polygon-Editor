# Relative paths are resolved from backend/, independent of the terminal directory.
GEOJSON_DATABASE_PATH=var/database/projects.db
GEOJSON_SQLITE_BUSY_TIMEOUT_MS=5000
GEOJSON_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Synchronous repository mutations / viewport response source budget
GEOJSON_REPOSITORY_MAX_FEATURE_BYTES=2097152
GEOJSON_REPOSITORY_MAX_FEATURE_VERTICES=100000
GEOJSON_REPOSITORY_MAX_DEPTH=64
GEOJSON_REPOSITORY_MAX_NODES=250000
GEOJSON_REPOSITORY_MAX_VIEWPORT_BYTES=67108864
GEOJSON_REPOSITORY_MAX_SIMPLIFICATION_STEPS=1000000

# Synchronous, read-only geometry validation limits
GEOJSON_VALIDATION_MAX_BYTES=5242880
GEOJSON_VALIDATION_MAX_FEATURES=500
GEOJSON_VALIDATION_MAX_VERTICES=100000
GEOJSON_VALIDATION_MAX_FEATURE_VERTICES=50000
GEOJSON_VALIDATION_MAX_DEPTH=64
GEOJSON_VALIDATION_MAX_NODES=250000
GEOJSON_VALIDATION_TIMEOUT_SECONDS=5
GEOJSON_VALIDATION_MAX_ISSUES_PER_FEATURE=20
GEOJSON_VALIDATION_MAX_CONCURRENT=2

# Independent large-file import / worker limits (bytes unless noted)
GEOJSON_IMPORT_MAX_BYTES=536870912
GEOJSON_IMPORT_DISK_QUOTA_BYTES=4294967296
GEOJSON_IMPORT_CHUNK_BYTES=65536
GEOJSON_IMPORT_BATCH_SIZE=500
GEOJSON_IMPORT_BATCH_BYTES=4194304
GEOJSON_IMPORT_MAX_FEATURE_BYTES=8388608
GEOJSON_IMPORT_MAX_METADATA_BYTES=1048576
GEOJSON_IMPORT_MAX_FEATURE_VERTICES=100000
GEOJSON_IMPORT_MAX_VERTICES=50000000
GEOJSON_IMPORT_MAX_FEATURES=2000000
GEOJSON_IMPORT_MAX_DEPTH=64
GEOJSON_IMPORT_MAX_FEATURE_NODES=500000
GEOJSON_IMPORT_MAX_CATEGORIES=10000
GEOJSON_IMPORT_MAX_CATEGORY_CHARS=1024
GEOJSON_IMPORT_MAX_UPLOADS=2
GEOJSON_IMPORT_MAX_RUNNING=2
GEOJSON_IMPORT_MAX_PENDING=10
GEOJSON_IMPORT_UPLOAD_TIMEOUT_SECONDS=1800
GEOJSON_IMPORT_UPLOAD_LEASE_SECONDS=60
GEOJSON_IMPORT_LEASE_SECONDS=30
GEOJSON_IMPORT_STALL_SECONDS=30
GEOJSON_IMPORT_JOB_TIMEOUT_SECONDS=3600
GEOJSON_IMPORT_WORKER_MEMORY_BYTES=536870912
GEOJSON_IMPORT_WARNING_SAMPLES=50
