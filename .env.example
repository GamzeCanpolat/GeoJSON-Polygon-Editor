# Default: browser Worker / IndexedDB. Restart Vite after changing these values.
VITE_DATA_SOURCE=local
# For API mode set VITE_DATA_SOURCE=api. VITE_* values are public browser config.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Prepared components remain unmounted in App until UI integration is approved.
VITE_PROJECT_MANAGEMENT=false
